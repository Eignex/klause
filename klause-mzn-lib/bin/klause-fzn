#!/usr/bin/env bash
# MiniZinc-facing wrapper for klause-cli.
#
# Usage: klause-fzn [flags] model.fzn
# KLAUSE_HOME: the klause checkout (default: two levels above this script).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KLAUSE_HOME="${KLAUSE_HOME:-$(cd "$HERE/../.." && pwd)}"

# Built by `./gradlew :klause-cli:installJvmDist`.
DIST_LAUNCHER="$KLAUSE_HOME/klause-cli/build/install/klause-cli-jvm/bin/klause-cli"

if [[ ! -x "$DIST_LAUNCHER" ]]; then
  echo "klause-fzn: distribution not found at $DIST_LAUNCHER" >&2
  echo "klause-fzn: build it with './gradlew :klause-cli:installJvmDist' (from $KLAUSE_HOME)" >&2
  exit 3
fi

exec "$DIST_LAUNCHER" "$@"
