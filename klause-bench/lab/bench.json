{
  "main": "com.eignex.klause.bench.lab.LabAdapterKt",
  "classpath": [
    "klause-bench/build/install/klause-bench/lib/*"
  ],
  "buildTasks": [
    ":klause-cli:installJvmDist",
    ":klause-bench:installDist",
    ":klause-bench:prepareLabRuntime"
  ],
  "planInputs": [
    "klause-bench",
    "build.gradle.kts",
    "settings.gradle.kts",
    "gradle.properties",
    "gradle"
  ],
  "jvmArgs": [
    "-Xmx512m",
    "--enable-native-access=ALL-UNNAMED",
    "--add-modules=jdk.incubator.vector"
  ],
  "runtime": {
    "java": 25,
    "tools": [
      "time"
    ],
    "environment": {}
  },
  "workspaceInputs": [
    ".git",
    "klause-bench/lab",
    "klause-bench/scripts",
    "klause-bench/smoke-corpus",
    "klause-bench/build/install",
    "klause-bench/build/lab-runtime",
    "klause-cli/build/install",
    "klause-mzn-lib"
  ]
}
