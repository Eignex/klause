{
  "main": "com.eignex.klause.bench.lab.LabAdapterKt",
  "classpath": [
    "klause-bench/build/install/klause-bench/lib/*"
  ],
  "buildTasks": [
    ":klause-cli:installJvmDist",
    ":klause-bench:installDist",
    ":klause-bench:prepareLabRuntime"
  ],
  "planInputs": [
    "klause-bench",
    "build.gradle.kts",
    "settings.gradle.kts",
    "gradle.properties",
    "gradle"
  ],
  "jvmArgs": [
    "-Xmx512m",
    "--enable-native-access=ALL-UNNAMED",
    "--add-modules=jdk.incubator.vector"
  ],
  "runtime": {
    "java": 25,
    "tools": [
      "time"
    ],
    "environment": {}
  }
}
