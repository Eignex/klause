% 3x3 magic square: a permutation of 1..9 with all rows, columns and both
% diagonals summing to 15. Satisfaction.
var 1..9: x1; var 1..9: x2; var 1..9: x3;
var 1..9: x4; var 1..9: x5; var 1..9: x6;
var 1..9: x7; var 1..9: x8; var 1..9: x9;
constraint all_different_int([x1, x2, x3, x4, x5, x6, x7, x8, x9]);
constraint int_lin_eq([1, 1, 1], [x1, x2, x3], 15);
constraint int_lin_eq([1, 1, 1], [x4, x5, x6], 15);
constraint int_lin_eq([1, 1, 1], [x7, x8, x9], 15);
constraint int_lin_eq([1, 1, 1], [x1, x4, x7], 15);
constraint int_lin_eq([1, 1, 1], [x2, x5, x8], 15);
constraint int_lin_eq([1, 1, 1], [x3, x6, x9], 15);
constraint int_lin_eq([1, 1, 1], [x1, x5, x9], 15);
constraint int_lin_eq([1, 1, 1], [x3, x5, x7], 15);
solve satisfy;
output ["magic = ", show(x1), show(x2), show(x3), show(x4), show(x5), show(x6), show(x7), show(x8), show(x9), "\n"];
