<instance format="XCSP3" type="COP">
  <variables><array id="x" size="[3][3]"> 0..2 </array></variables>
  <constraints>
    <sum><list> x[0][] </list><condition> (eq,2) </condition></sum>
    <sum><list> x[1][] </list><condition> (eq,2) </condition></sum>
    <sum><list> x[2][] </list><condition> (eq,2) </condition></sum>
    <sum><list> x[][0] </list><condition> (eq,2) </condition></sum>
    <sum><list> x[][1] </list><condition> (eq,2) </condition></sum>
    <sum><list> x[][2] </list><condition> (eq,2) </condition></sum>
  </constraints>
  <objectives><minimize type="sum">
    <list> x[][] </list><coeffs> 6 5 5 15 16 15 25 25 26 </coeffs>
  </minimize></objectives>
</instance>
