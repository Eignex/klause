<instance format="XCSP3" type="COP">
  <variables>
    <var id="x">1..3</var>
    <var id="y">0..2</var>
    <var id="z">0..2</var>
    <var id="w">0..2</var>
  </variables>
  <constraints>
    <sum><list>x y</list><coeffs>1 -1</coeffs><condition>(eq,1)</condition></sum>
    <extension><list>x z</list><supports>(1,0)(2,1)(3,2)</supports></extension>
    <extension><list>y w</list><supports>(0,0)(1,1)(2,2)</supports></extension>
  </constraints>
  <objectives><minimize type="sum"><list>z w</list></minimize></objectives>
</instance>
