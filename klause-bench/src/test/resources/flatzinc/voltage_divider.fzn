var bool: X_INTRODUCED_15_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_16_ ::var_is_introduced :: is_defined_var;
array [1..6] of var float: X_INTRODUCED_0_ ::var_is_introduced  = [V,R1,R2,VD,0.1,I];
constraint float_lin_eq(X_INTRODUCED_7_,[V,X_INTRODUCED_3_,VD],-0.0):: defines_var(V);
constraint float_lin_eq(X_INTRODUCED_7_,[I,X_INTRODUCED_2_,0.1],-0.0):: defines_var(I);
