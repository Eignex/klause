constraint float_eq_reif(R1,9.0,X_INTRODUCED_12_):: defines_var(X_INTRODUCED_12_);
constraint float_eq_reif(R1,14.0,X_INTRODUCED_13_):: defines_var(X_INTRODUCED_13_);
