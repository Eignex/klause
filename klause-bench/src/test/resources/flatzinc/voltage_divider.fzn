predicate float_eq_reif(var float: a,var float: b,var bool: r);
predicate bool_clause(array [int] of var bool: as,array [int] of var bool: bs);
array [1..3] of float: X_INTRODUCED_7_ = [1.0,-1.0,-1.0];
var -100.0..100.0: V:: output_var:: is_defined_var;
var -100.0..100.0: R1:: output_var;
var -100.0..100.0: R2:: output_var;
var 5.4..5.5: VD:: is_defined_var:: output_var;
var -100.0..100.0: I:: output_var:: is_defined_var;
var float: X_INTRODUCED_2_ ::var_is_introduced ;
var -10000.0..10000.0: X_INTRODUCED_3_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_9_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_10_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_11_ ::var_is_introduced :: is_defined_var;
