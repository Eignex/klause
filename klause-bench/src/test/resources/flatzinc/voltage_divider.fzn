constraint bool_clause([X_INTRODUCED_13_,X_INTRODUCED_12_,X_INTRODUCED_11_],[]);
constraint bool_clause([X_INTRODUCED_16_,X_INTRODUCED_15_,X_INTRODUCED_14_],[]);
constraint float_times(X_INTRODUCED_2_,R2,VD):: defines_var(VD);
constraint float_times(I,R1,X_INTRODUCED_3_):: defines_var(X_INTRODUCED_3_);
constraint float_eq_reif(V,9.0,X_INTRODUCED_9_):: defines_var(X_INTRODUCED_9_);
constraint float_eq_reif(V,12.0,X_INTRODUCED_10_):: defines_var(X_INTRODUCED_10_);
