<instance format="XCSP3" type="CSP">
  <variables>
    <var id="x">0..2</var>
    <var id="b">0..1</var>
    <var id="c">0..1</var>
  </variables>
  <constraints>
    <extension>
      <list>c x</list>
      <supports>(0,0)(0,1)(0,2)(1,0)(1,2)</supports>
    </extension>
    <intension>eq(eq(b,1),ne(x,1))</intension>
  </constraints>
</instance>
